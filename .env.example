# Copy to .env.local and fill in what you need. Every key is optional.

# Where lead form submissions are forwarded (Zapier, Make, n8n, Google Apps Script...).
# When set, POST /api/leads forwards each lead as JSON and GET /api/leads is disabled.
# When empty, leads are kept in server memory (sandbox).
LEADS_WEBHOOK_URL=

# Public URL of the deployment, used for canonical URLs and Open Graph images.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3103.
NEXT_PUBLIC_SITE_URL=

# Endpoint that receives track() events. Defaults to the built-in /api/events sandbox sink.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
